{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read(memory/**)",
      "Write(memory/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\"",
            "timeout": 10,
            "statusMessage": "Reading FindMeSaaS status..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate_idea.py\"",
            "timeout": 30,
            "statusMessage": "Validating idea against its contract..."
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  }
}
